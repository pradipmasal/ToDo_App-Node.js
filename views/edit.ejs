<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Edit Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container">
        <h3 class="pt-5 pb-5 text-center">To-Do App - Edit Page</h3>
        <form action="/todo/update/<%= data._id %>" method="POST" style="width: 500px; margin:auto;">
            <div class="form-group">
                <span style="display: flex;">
                    <input type="text" name="task" class="form-control"  value="<%= data.task %>">
                    <button type="submit" class="btn btn-primary" style="width: 200px;">
                        <i class="fa fa-plus"></i> Update
                    </button>
                </span>
            </div>
        </form>
    </div>
    
    <!-- Add FontAwesome CDN for icons if needed -->
    <script src="https://kit.fontawesome.com/a076d05399.js"></script>
</body>
</html>
