<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Node.js To-Do App</title>
    <!-- Add Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Add Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <div class="container">
        <h3 class="pt-5 text-center">Node.js To-Do App</h3>
        <div class="row">
            <h4>My Day</h4>
            <!-- Display current date -->
            <p class="text-muted"><%= new Date().toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
            
            <div class="col-md-7 col-lg-7" style="height: 450px; overflow: scroll;">
                <!-- List of all the tasks for the day -->
                <% data.forEach((task) => { %>
                <div class="card m-1">
                    <div class="card-body">
                        <strong>Task:</strong> <%= task.task %> <br>
            <small class="text-muted">Created At: <%= new Date(task.createdAt).toLocaleString() %></small><br>
            <small class="text-muted">Updated At: <%= new Date(task.updatedAt).toLocaleString() %></small>
            <span style="position: relative; float: right;">
                <a href="/todo/completed/<%= task._id %>" class="btn btn-success"><i class="fa fa-check"></i> Mark as Done</a>
                <a href="/todo/delete/<%= task._id %>" class="btn btn-danger"><i class="fa fa-trash"></i></a>
                <a href="/todo/edit/<%= task._id %>" class="btn btn-primary"><i class="fa fa-pencil"></i></a>
            </span>
                    </div>
                </div>
                <% }) %>
            </div>

            <div class="col-md-5 col-lg-5" style="height: 450px; overflow: scroll;">
                <h5>Completed Tasks</h5>
                <!-- List of all the completed tasks -->
                <% completedTasks.forEach((task) => { %>
                <div class="card m-1" >
                    <div class="card-body" >
                        <!-- This is the completed task -->
                        <strong>Task:</strong> <%= task.task %> <br>
                        <small class="text-muted">Created At: <%= new Date(task.createdAt).toLocaleString() %></small><br>
                        <small class="text-muted">Updated At: <%= new Date(task.updatedAt).toLocaleString() %></small>
                        <span style="position: relative; float: right;">
                            <a href="/todo/undone/<%= task._id %>" class="btn btn-danger"><i class="fa fa-times"></i> Mark as UnDone</a>
                        </span>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 col-lg-6 p-0" style="position: absolute; bottom: 50px;">
                <!-- To-Do Form -->
                <form action="/todo/save" method="POST">
                    <div class="form-group">
                        <span style="display: flex;">
                            <input type="text" name="task" class="form-control" placeholder="Add a task">
                            <button type="submit" class="btn btn-primary" style="width: 200px;"><i class="fa fa-plus"></i> Add</button>
                        </span>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Add Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
